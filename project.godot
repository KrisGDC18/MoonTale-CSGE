; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Moontale"
run/main_scene="res://data/EventSystem/Game.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="uid://cljbhrx02ncrc"

[autoload]

player="*uid://sniu0w5cff26"
Globals="*res://data/Scripts/globals.gd"
AssetManager="*res://data/Scripts/asset_manager.gd"
MusicManager="*uid://co26fyvsg3pjc"
HealSystem="*uid://clyrac4onqmqh"
CamaraResize="*uid://dyggt8jkxabv4"
PlayerInventory="*uid://s8glxqg0w8yk"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true
window/vsync/vsync_mode=2

[editor_plugins]

enabled=PackedStringArray()

[global_group]

dialogue_box="Caja de dialogo"

[importer_defaults]

animation_library={
&"animation/fps": 60.0
}

